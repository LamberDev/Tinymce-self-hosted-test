{
  "name": "angularjs-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AngularJS 1.x app consuming self-hosted TinyMCE 8 (GPL) through a reusable <tiny-editor> component.",
  "scripts": {
    "postinstall": "node ../../scripts/copy-tinymce.mjs ./public/tinymce",
    "predev": "node ../../scripts/copy-tinymce.mjs ./public/tinymce",
    "prebuild": "node ../../scripts/copy-tinymce.mjs ./public/tinymce",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "angular": "^1.8.3",
    "tinymce": "^8.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "vite": "^6.0.0"
  }
}
